{
  "name": "cutwright",
  "productName": "Cutwright",
  "version": "0.1.0",
  "description": "Cutwright — an agent-driven desktop video editor. The edit is data (project.json); works with Claude Code in a side terminal.",
  "type": "module",
  "main": "electron/main.js",
  "author": "Avijit Sarkar",
  "license": "Apache-2.0",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "rebuild": "electron-rebuild -f -w node-pty",
    "dev": "npm run vendor && electron .",
    "smoke": "npm run vendor && CVE_SMOKE=ui,term,render CVE_SMOKE_OUT=./out/smoke electron .",
    "pack": "npm run vendor && electron-builder --dir",
    "dist": "npm run vendor && electron-builder --mac dmg --arm64",
    "dist:win": "npm run vendor && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "fix-path": "5.0.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@electron/notarize": "3.1.0",
    "@electron/rebuild": "4.2.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.avijitsarkar.cutwright",
    "productName": "Cutwright",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "schema/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/node-pty/**/*"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "identity": null,
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "Cutwright ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "afterSign": "build/notarize.cjs"
  }
}
