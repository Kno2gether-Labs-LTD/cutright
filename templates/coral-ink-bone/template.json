{
  "id": "coral-ink-bone",
  "name": "Coral / Ink / Bone",
  "version": "1.0.0",
  "author": "Cutright",
  "license": "Apache-2.0",
  "description": "Editorial serif headlines, rounded-sans pills and word-by-word highlight captions. The default look.",
  "engine": "hyperframes",
  "sceneEngine": "pillow",
  "tokens": {
    "coral": "#E5533D",
    "ink": "#1A1A18",
    "bone": "#F1EFE7",
    "lime": "#C4D82E",
    "sky": "#6FB7E8",
    "displayFont": "Bodoni 72, Didot, Georgia, serif",
    "uiFont": "Arial Rounded MT Bold, Arial Rounded Bold, Arial, sans-serif"
  },
  "captions": {
    "style": "highlight",
    "font": "/System/Library/Fonts/Supplemental/Arial Rounded Bold.ttf",
    "color": "#FFFFFF",
    "highlight": "#E5533D"
  },
  "scenes": [
    "pills",
    "checklist",
    "counter",
    "stat",
    "strike"
  ],
  "overlays": [
    {
      "id": "lower-third",
      "name": "Lower third",
      "composition": "overlays/lower-third.html",
      "duration": 4,
      "vars": [
        {
          "name": "tag",
          "label": "Tag",
          "default": "SELF-HOSTED"
        },
        {
          "name": "title",
          "label": "Title",
          "default": "YOUR OWN RELAY SERVER"
        },
        {
          "name": "sub",
          "label": "Subtitle",
          "default": "RUNS ON YOUR VPS"
        }
      ]
    },
    {
      "id": "title-card",
      "name": "Title card",
      "composition": "overlays/title-card.html",
      "duration": 3.5,
      "vars": [
        {
          "name": "kicker",
          "label": "Kicker",
          "default": "CHAPTER 01"
        },
        {
          "name": "title",
          "label": "Title",
          "default": "Set up the relay"
        }
      ]
    },
    {
      "id": "callout",
      "name": "Callout chip",
      "composition": "overlays/callout.html",
      "duration": 2.5,
      "vars": [
        {
          "name": "text",
          "label": "Text",
          "default": "ONE CLICK"
        },
        {
          "name": "corner",
          "label": "Corner (tl/tr/bl/br)",
          "default": "tr"
        }
      ]
    }
  ],
  "pacing": {
    "minPanel": 2.6,
    "maxPanel": 8.0,
    "wordsPerSecond": 2.1,
    "followSpeech": true,
    "slide": 0.55,
    "note": "editorial pace \u2014 a beat longer, the panels carry more text"
  },
  "grade": {
    "look": "film",
    "grain": 12,
    "vignette": 0.18,
    "audioPolish": "voice"
  },
  "framing": {
    "panel": {
      "to": "card"
    },
    "corner": {
      "to": "corner",
      "shape": "circle",
      "size": 0.26,
      "corner": "br",
      "margin": 0.045,
      "backdrop": "brand"
    },
    "backdropBase": "#1A1A18",
    "backdropGlow": "#E5533D",
    "backdropGlow2": "#6FB7E8"
  }
}