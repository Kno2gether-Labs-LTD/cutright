{
  "id": "midnight-chalk",
  "name": "Midnight Chalk",
  "version": "1.0.0",
  "author": "Cutright",
  "license": "Apache-2.0",
  "description": "Dark chalkboard aesthetic — hand-drawn rules, chalk-white type, amber accents. Good for tutorials and code.",
  "engine": "hyperframes",
  "sceneEngine": "pillow",
  "tokens": {
    "chalk": "#F3EFE6", "board": "#12161A", "amber": "#F2B441", "mint": "#6FD3A8", "rose": "#F2789A",
    "displayFont": "Georgia, 'Times New Roman', serif",
    "uiFont": "'SF Mono', ui-monospace, Menlo, monospace"
  },
  "captions": {
    "style": "highlight",
    "font": "/System/Library/Fonts/Supplemental/Arial Rounded Bold.ttf",
    "color": "#F3EFE6",
    "highlight": "#F2B441"
  },
  "scenes": ["pills", "checklist", "counter", "stat", "strike"],
  "overlays": [
    {
      "id": "chalk-lower-third",
      "name": "Chalk lower third",
      "composition": "overlays/lower-third.html",
      "duration": 4,
      "vars": [
        { "name": "title", "label": "Title", "default": "THE RELAY SERVER" },
        { "name": "sub", "label": "Subtitle", "default": "self-hosted, one click" }
      ]
    },
    {
      "id": "chalk-note",
      "name": "Margin note",
      "composition": "overlays/note.html",
      "duration": 3,
      "vars": [
        { "name": "text", "label": "Note", "default": "keep your data" },
        { "name": "side", "label": "Side (left/right)", "default": "right" }
      ]
    }
  ]
}
